{
  "name": "interviewos",
  "version": "1.0.0",
  "description": "InterviewOS: a static, offline-first interview learning system and public technical education site.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razsekar/interviewos.git"
  },
  "bugs": {
    "url": "https://github.com/razsekar/interviewos/issues"
  },
  "homepage": "https://github.com/razsekar/interviewos#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extract": "node tools/extract-pdf/extract.mjs",
    "validate": "node tools/validate-content/validate.mjs",
    "css": "tailwindcss -c tailwind.config.cjs -i src/styles/input.css -o dist/assets/app.css --minify",
    "build:site": "node tools/build/build.mjs",
    "build": "npm run validate && npm run build:site && npm run css && node tools/build/post-build.mjs",
    "check": "node tools/check/check-site.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "serve": "node tools/serve.mjs",
    "ci": "npm run build && npm run check && npm run report && npm test",
    "report": "node tools/report/content-report.mjs",
    "test:e2e": "node --test tests/e2e/app.e2e.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "3.4"
  }
}
